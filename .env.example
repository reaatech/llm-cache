# LLM-Cache Server Configuration
# Copy this file to .env and fill in your values.

# Server
PORT=3000
MAX_BODY_BYTES=1048576

# Authentication (optional — leave empty to disable)
LLM_CACHE_API_KEY=

# Storage Adapter: memory | redis | dynamodb
STORAGE_ADAPTER=redis
REDIS_URL=redis://localhost:6379

# DynamoDB (only needed when STORAGE_ADAPTER=dynamodb)
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=llm-cache
DYNAMODB_ENDPOINT=http://localhost:8000

# Vector Storage Adapter: memory | qdrant
VECTOR_STORAGE_ADAPTER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=llm-cache
QDRANT_API_KEY=

# Embedding Provider (currently only openai)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Embedding Tuning
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3

# Similarity Configuration
SIMILARITY_THRESHOLD=0.8
SIMILARITY_MAX_RESULTS=10

# TTL Configuration (in seconds)
TTL_DEFAULT=3600
TTL_FACTUAL=1800
TTL_CREATIVE=7200
TTL_ANALYTICAL=3600
TTL_SENSITIVE=600

# Segmentation
SEGMENTATION_ENABLED=true
DEFAULT_USE_CASE=general

# Cost Tracking
COST_TRACKING_ENABLED=true
COST_CURRENCY=USD

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=false
LOG_LEVEL=info
